{
  "cleanUrls":true,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|svg|webp|avif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'"
        }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/idontfishforfoodifishforvibes/classicshirt",
      "destination": "/js/pages/idontfishforfoodifishforvibes/classicshirt"
    },
    {
      "source": "/idontfishforfoodifishforvibes/premiumshirt",
      "destination": "/js/pages/idontfishforfoodifishforvibes/premiumshirt"
    },
    {
      "source": "/idontfishforfoodifishforvibes/oversizedshirt",
      "destination": "/js/pages/idontfishforfoodifishforvibes/oversizedshirt"
    },
    {
      "source": "/idontfishforfoodifishforvibes",
      "destination": "/idontfishforfoodifishforvibes"
    },
    {
      "source": "/about",
      "destination": "/about"
    },
    {
      "source": "/shop",
      "destination": "/shop"
    },
    {
      "source": "/service",
      "destination": "/service"
    },
    {
      "source": "/blog",
      "destination": "/blog"
    },
    {
      "source": "/contact",
      "destination": "/contact"
    },
    {
      "source": "/deepseamonster",
      "destination": "/deepseamonster"
    }
  ]
}