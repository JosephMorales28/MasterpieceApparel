[diff ="webp"]
   textconv = identify  -verbose

[diff ="avif"]
   textconv = avifinfo

[diff ="webm"]
   textconv = ffprobe -show_streams -show_format -v quiet

[diff "image"]
    textconv = identify -verbose

[diff "image"]
    textconv = exiftool
    
[diff "video"]
    textconv = ffprobe -show_streams -show_format -v quiet
