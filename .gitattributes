*text=auto

# Web code consistency
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.scss text eol=lf

# custom diff
*.jpg filter=lfs diff=image merge=lfs -text
*.jpeg filter=lfs diff=image merge=lfs -text
*.png filter=lfs diff=image merge=lfs -text
*.webp filter=lfs diff=image merge=lfs -text
*.avif filter=lfs diff=image merge=lfs -text

*.webm filter=lfs diff=video merge=lfs -text
*.mp4 filter=lfs diff=video merge=lfs -text
*.mov filter=lfs diff=video merge=lfs -text
*.wav filter=lfs diff=video merge=lfs -text

